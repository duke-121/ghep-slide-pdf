{
  "name": "Nếp Giấy – Canva sang PDF",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "overrideCommand": true,
  "remoteUser": "pwuser",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Nếp Giấy · Canva sang PDF",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "nohup node /app/converter.mjs >/tmp/nep-giay.log 2>&1 </dev/null &"
}
